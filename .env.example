# --------------------------------------------------------------------------
# Plantilla de configuración de los contenedores.
# 1. Copia este archivo con el nombre ".env"   (cp .env.example .env)
# 2. Escribe tu propia clave en POSTGRES_PASSWORD.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# Si la clave queda vacía, PostgreSQL no inicia (evita bases sin contraseña).
# --------------------------------------------------------------------------

# Base de datos PostgreSQL (se cargan en los contenedores con env_file)
POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=

# Puertos en tu computador
APP_PORT=8080
ADMINER_PORT=8081

# Cargar datos de ejemplo si la base de datos está vacía (true / false)
SEED_DEMO=true
