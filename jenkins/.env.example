# --------------------------------------------------------------------------
# Plantilla de configuración de Jenkins.
# 1. Copia este archivo como ".env" dentro de la carpeta jenkins/
# 2. Define el usuario y las claves. El .env NO se sube a GitHub.
# --------------------------------------------------------------------------

# Usuario administrador de Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=

# Clave de PostgreSQL que usará el pipeline en su entorno de pruebas.
# Jenkins la guarda como credencial "multimateriales-db-password" (Secret text).
# Usa solo letras y números.
CI_DB_PASSWORD=
