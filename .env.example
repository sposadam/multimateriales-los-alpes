# --------------------------------------------------------------------------
# Configuración de los contenedores.
# 1. Copia este archivo con el nombre ".env"  (cp .env.example .env)
# 2. Cambia la contraseña. El archivo .env NO se sube a GitHub (.gitignore).
# Sin .env, "docker compose up" se detiene pidiendo POSTGRES_PASSWORD.
# --------------------------------------------------------------------------

# Base de datos PostgreSQL
POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia_esta_clave

# Puertos en tu computador
APP_PORT=8080
ADMINER_PORT=8081

# Cargar datos de ejemplo si la base de datos está vacía (true / false)
SEED_DEMO=true
